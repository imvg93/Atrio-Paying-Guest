# Local configuration for the Spring Boot API.
#   cp backend-java/.env.example backend-java/.env
# backend-java/.env is git-ignored. In production, set these as real
# environment variables instead (application-prod.yml ignores .env files).
#
# The Spring profile is NOT set here. Run locally with:
#   ./mvnw spring-boot:run -Dspring-boot.run.profiles=local
# Deployments must set SPRING_PROFILES_ACTIVE=prod as an environment variable.

# ---- Database (PostgreSQL) ----
# For the local docker Postgres (backend/docker-compose.yml) use
# DB_HOST=localhost, DB_NAME=atrio_pg, DB_SSLMODE=disable.
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USERNAME=
DB_PASSWORD=
# require (default, Supabase) | disable (local docker) | verify-full
DB_SSLMODE=require
# Hikari pool size. Defaults: 10 (local), 20 (prod).
# DB_POOL_MAX=10

# ---- Auth (JWT) ----
# Both secrets are required and must be at least 32 characters, or the app
# refuses to start. Generate each with: openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# JWT_ACCESS_TTL=15m
# JWT_REFRESH_TTL=30d

# ---- OTP policy (defaults shown) ----
# OTP_TTL_SECONDS=300
# OTP_MAX_ATTEMPTS=5
# OTP_REQUEST_LIMIT=3
# OTP_REQUEST_WINDOW_SECONDS=600

# ---- Server ----
# SERVER_PORT=8080
